# Reference copy: the canonical unit is generated by `legionr harden --install`.
# Regenerate: legionr --config /etc/legion-runner/<name>.json harden
#
[Unit]
Description=Legion Runner (ephemeral GitHub Actions runner) %i
Documentation=https://github.com/Wraith-security/legion_runner
After=network-online.target
Wants=network-online.target
# Back off on a fast crash loop (e.g. bad credentials): 5 starts per
# 5 minutes, then stop. Without this, Restart=always + RestartSec=2
# hammers GitHub's generate-jitconfig ~30x/min until the rate limit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# One job, then exit. Restart=always immediately provisions a fresh
# ephemeral runner, so a single unit yields a continuous single-use pool.
ExecStart=/usr/local/bin/legionr run --once --config /etc/legion-runner/%i.json
# Credential for runner registration, loaded from a root-owned env
# file (services do not inherit a shell env). Put the GitHub App
# config here (LEGIONR_APP_ID and LEGIONR_APP_PRIVATE_KEY_FILE) or a
# LEGIONR_TOKEN. Jobs never see these: they run as the job user with
# an environment rebuilt from a short allowlist. Optional (leading
# '-'): the unit still starts if the file is absent.
EnvironmentFile=-/etc/legion-runner/%i.env
Restart=always
RestartSec=2
TimeoutStopSec=90

# ── Identity ────────────────────────────────────────────────
User=legionr
Group=legionr
DynamicUser=no

# Jobs run as legionr-job, never as legionr: a job sharing the control
# plane's uid could read its credential. legionr starts each job as
# legionr-job from a fresh copy of the runner, with its own HOME and
# TMP under /opt/legion-runner/_work, and wipes all of it afterwards.

# ── Filesystem ──────────────────────────────────────────────
ProtectSystem=strict
ProtectHome=true
# Only the per-job scratch root is writable. The installed runner
# (/opt/legion-runner/runner) stays a read-only template no job can modify.
ReadWritePaths=/opt/legion-runner/_work
ReadOnlyPaths=/opt/legion-runner/runner
UMask=0077
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid

# ── Privilege ───────────────────────────────────────────────
# Only CAP_SETUID and CAP_SETGID, so legionr can start each job as
# legionr-job. The job itself gets none: legionr clears every capability
# set and sets no_new_privs before exec, and checks that before each job.
NoNewPrivileges=true
RestrictSUIDSGID=true
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID

# ── Namespaces & kernel surface ─────────────────────────────
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete
# @privileged includes setuid/setgid/setgroups and capset; allow
# those back for the drop to legionr-job (capset clears the job's
# capabilities). chroot, mount and the rest of @privileged stay denied.
SystemCallFilter=@setuid capset

# ── Resource limits (DoS containment) ───────────────────────
TasksMax=512
MemoryMax=6G
CPUQuota=400%

[Install]
WantedBy=multi-user.target

